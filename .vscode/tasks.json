{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start dev server",
      "detail": "docker compose up -d, wait for ready, open http://localhost:8080",
      "type": "shell",
      "command": "docker compose up -d && until curl -sf http://localhost:8080 > /dev/null 2>&1; do sleep 1; done && xdg-open http://localhost:8080",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },
    {
      "label": "Stop dev server",
      "detail": "docker compose down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Restart dev server",
      "detail": "docker compose restart — picks up _config.yml changes",
      "type": "shell",
      "command": "docker compose restart",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Tail dev server logs",
      "detail": "docker compose logs -f",
      "type": "shell",
      "command": "docker compose logs -f",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    }
  ]
}
